<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DeferredReality.Wildlife</RootNamespace>
    <AssemblyName>DeferredReality.Wildlife</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <OutputPath>..\..\1.6\OptionalDeferredReality\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <DeferredRealityRequireKnowledgeFramework>false</DeferredRealityRequireKnowledgeFramework>
    <DeferredRealityRequireHarmony>true</DeferredRealityRequireHarmony>
  </PropertyGroup>
  <Import Project="..\..\DevTools\RimWorldReferences.props" />
  <Target Name="ValidateDeferredRealityIntegrationReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(DeferredRealityFrameworkAssemblyPath)' == '' or !Exists('$(DeferredRealityFrameworkAssemblyPath)')" Text="The optional Deferred Reality adapter requires DeferredRealityFramework.dll. Set DeferredRealityFrameworkRoot or DEFERRED_REALITY_FRAMEWORK_PATH." />
  </Target>
  <ItemGroup>
    <Compile Include="DeferredRealityWildlifeAdapter.cs" />
    <Compile Include="DeferredRealityWildlifeAdjacent.cs" />
    <Compile Include="DeferredRealityWildlifeIntegrationChecks.cs" />
    <Compile Include="DeferredRealityWildlifePolicy.cs" />
    <ProjectReference Include="Wildlife.csproj" ReferenceOutputAssembly="true" Private="false" />
    <ProjectReference Include="..\Herds\Herds.csproj" ReferenceOutputAssembly="true" Private="false" />
    <Reference Include="DeferredRealityFramework">
      <HintPath>$(DeferredRealityFrameworkAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DeferredRealityManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DeferredRealityManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(DeferredRealityHarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="KeepOptionalIntegrationOutputScoped" AfterTargets="Build">
    <ItemGroup>
      <OptionalIntegrationDependencies Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)DeferredReality.Wildlife.dll" />
    </ItemGroup>
    <Delete Files="@(OptionalIntegrationDependencies)" />
  </Target>
</Project>
